---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Cimentaciones Profundas
const images = [
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/46b2a5ee-d186-4afc-949e-c6956fc1e782.jpg',
    alt: 'Cimentación Profunda - Proyecto 1',
    title: 'Cimentación Profunda - Proyecto 1'
  },
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/COLOCACIÓN DE BASES Y ENCOFRADO.jpg',
    alt: 'Colocación de Bases y Encofrado',
    title: 'Colocación de Bases y Encofrado'
  },
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/ENCOFRADO PARA ESTACIÓN DE TREN.jpg',
    alt: 'Encofrado para Estación de Tren',
    title: 'Encofrado para Estación de Tren'
  }
];
---

<Layout>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-stone-600 to-slate-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-altone-bold mb-4">Cimentaciones Profundas</h1>
      <p class="text-xl opacity-90 max-w-3xl mx-auto">
        Diseño y construcción de cimentaciones profundas para estructuras de gran envergadura y proyectos de infraestructura crítica.
      </p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center text-white hover:text-stone-200 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }
  
  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>