---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Cimentaciones Profundas
const images = [
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/46b2a5ee-d186-4afc-949e-c6956fc1e782.jpg',
    alt: 'Cimentación Profunda - Proyecto 1',
    title: 'Cimentación Profunda - Proyecto 1'
  },
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/COLOCACIÓN DE BASES Y ENCOFRADO.jpg',
    alt: 'Colocación de Bases y Encofrado',
    title: 'Colocación de Bases y Encofrado'
  },
  {
    src: '/GEOTECNIA/CIMENTACIONES PROFUNDAS/ENCOFRADO PARA ESTACIÓN DE TREN.jpg',
    alt: 'Encofrado para Estación de Tren',
    title: 'Encofrado para Estación de Tren'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">CIMENTACIONES PROFUNDAS</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>