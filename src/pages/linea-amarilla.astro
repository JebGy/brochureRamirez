---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Línea Amarilla
const images = [
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/528419b6-cdb9-48e4-ab9a-de5ccc954bac.jpg',
    alt: 'Línea Amarilla - Proyecto 1',
    title: 'Línea Amarilla - Proyecto 1'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/7382cc31-de82-4a6a-a850-6bf2013088d4.jpg',
    alt: 'Línea Amarilla - Proyecto 2',
    title: 'Línea Amarilla - Proyecto 2'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/EXCAVADORA.jpg',
    alt: 'Excavadora',
    title: 'Excavadora'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/RETROEXCAVADORA Y CAMIÓN VOLQUETE.jpg',
    alt: 'Retroexcavadora y Camión Volquete',
    title: 'Retroexcavadora y Camión Volquete'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/RETROEXCAVADORA(1).jpg',
    alt: 'Retroexcavadora',
    title: 'Retroexcavadora'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/LINEA AMARILLA/RETROEXCAVADORA.jpg',
    alt: 'Retroexcavadora',
    title: 'Retroexcavadora'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">LÍNEA AMARILLA</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>