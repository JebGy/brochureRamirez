---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Vías de Acceso
const images = [
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/231f1fb0-4244-4a5f-8147-d403cae45e52.jpg',
    alt: 'Vía de Acceso - Proyecto 1',
    title: 'Vía de Acceso - Proyecto 1'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/573bbde3-bd7e-4ec0-b305-b7825d6f7ff3.jpg',
    alt: 'Vía de Acceso - Proyecto 2',
    title: 'Vía de Acceso - Proyecto 2'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/CENTROS DE ACOPIO EN REFINERÍA(1).jpg',
    alt: 'Centros de Acopio en Refinería',
    title: 'Centros de Acopio en Refinería'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/CENTROS DE ACOPIO EN REFINERÍA.jpg',
    alt: 'Centros de Acopio en Refinería',
    title: 'Centros de Acopio en Refinería'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/d449cd3a-6244-4d14-80fc-0bb65fc2cda4.jpg',
    alt: 'Vía de Acceso - Proyecto 3',
    title: 'Vía de Acceso - Proyecto 3'
  }
];
---

<Layout>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-altone-bold mb-4">Vías de Acceso</h1>
      <p class="text-xl opacity-90 max-w-3xl mx-auto">
        Construcción y mantenimiento de vías de acceso para facilidades industriales y centros de operaciones.
      </p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center text-white hover:text-emerald-200 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }
  
  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>