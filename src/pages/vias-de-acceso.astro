---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Vías de Acceso
const images = [
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/231f1fb0-4244-4a5f-8147-d403cae45e52.webp',
    alt: 'Vía de Acceso - Proyecto 1',
    title: 'Vía de Acceso - Proyecto 1'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/573bbde3-bd7e-4ec0-b305-b7825d6f7ff3.webp',
    alt: 'Vía de Acceso - Proyecto 2',
    title: 'Vía de Acceso - Proyecto 2'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/CENTROS DE ACOPIO EN REFINERÍA(1).webp',
    alt: 'Centros de Acopio en Refinería',
    title: 'Centros de Acopio en Refinería'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/CENTROS DE ACOPIO EN REFINERÍA.webp',
    alt: 'Centros de Acopio en Refinería',
    title: 'Centros de Acopio en Refinería'
  },
  {
    src: '/MANTENIMIENTO/VIAS DE ACCESO/d449cd3a-6244-4d14-80fc-0bb65fc2cda4.webp',
    alt: 'Vía de Acceso - Proyecto 3',
    title: 'Vía de Acceso - Proyecto 3'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">VÍAS DE ACCESO</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>