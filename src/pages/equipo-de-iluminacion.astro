---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Equipo de Iluminación
const images = [
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/EQUIPOS DE ILUMINACIÓN/0fcfb9a0-1749-4553-9dea-7f596bc4174c.jpg',
    alt: 'Equipo de Iluminación - Proyecto 1',
    title: 'Equipo de Iluminación - Proyecto 1'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/EQUIPOS DE ILUMINACIÓN/276a8864-eb5b-4b14-80b2-c1c48db1f202.jpg',
    alt: 'Equipo de Iluminación - Proyecto 2',
    title: 'Equipo de Iluminación - Proyecto 2'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/EQUIPOS DE ILUMINACIÓN/cea235ef-56b6-4b80-97ec-016e60d14009.jpg',
    alt: 'Equipo de Iluminación - Proyecto 3',
    title: 'Equipo de Iluminación - Proyecto 3'
  }
];
---

<Layout>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-purple-600 to-indigo-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-altone-bold mb-4">Equipo de Iluminación</h1>
      <p class="text-xl opacity-90 max-w-3xl mx-auto">
        Alquiler de equipos de iluminación industrial para proyectos nocturnos y trabajos en espacios con poca visibilidad.
      </p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center text-white hover:text-purple-200 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }
  
  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>