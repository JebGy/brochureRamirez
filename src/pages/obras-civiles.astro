---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Obras Civiles
const images = [
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/COLOCACIÓN DE ASFALTO.jpg',
    alt: 'Colocación de Asfalto',
    title: 'Colocación de Asfalto'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/CONSTRUCCIÓN DE ALMACENES Y OFICINAS.jpg',
    alt: 'Construcción de Almacenes y Oficinas',
    title: 'Construcción de Almacenes y Oficinas'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/CONSTRUCCIÓN DE OFICINAS Y ALMACENES.jpg',
    alt: 'Construcción de Oficinas y Almacenes',
    title: 'Construcción de Oficinas y Almacenes'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/ENCOFRADO PARA INSTALACIÓN DE POZO A TIERRA.jpg',
    alt: 'Encofrado para Instalación de Pozo a Tierra',
    title: 'Encofrado para Instalación de Pozo a Tierra'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/ENCOFRADO Y VACIADO DE CONCRETO.jpg',
    alt: 'Encofrado y Vaciado de Concreto',
    title: 'Encofrado y Vaciado de Concreto'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/LOSAS DE TOSTACIÓN.jpg',
    alt: 'Losas de Tostación',
    title: 'Losas de Tostación'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/MODERNIZACIÓN DE TERMINAL PORTUARIO(1).jpg',
    alt: 'Modernización de Terminal Portuario',
    title: 'Modernización de Terminal Portuario'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/MODERNIZACIÓN DE TERMINAL PORTUARIO.jpg',
    alt: 'Modernización de Terminal Portuario',
    title: 'Modernización de Terminal Portuario'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/OBRAS VIALES EN REFINERÍA(1).jpg',
    alt: 'Obras Viales en Refinería',
    title: 'Obras Viales en Refinería'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/OBRAS VIALES EN REFINERÍA.jpg',
    alt: 'Obras Viales en Refinería',
    title: 'Obras Viales en Refinería'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/REPARACIÓN DE ESPESADOR EN REFINERÍA.jpg',
    alt: 'Reparación de Espesador en Refinería',
    title: 'Reparación de Espesador en Refinería'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/TENDIDO DE POZO A TIERRA.jpg',
    alt: 'Tendido de Pozo a Tierra',
    title: 'Tendido de Pozo a Tierra'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/TENDIDO ELÉCTRICO SUBTERRÁNEO.jpg',
    alt: 'Tendido Eléctrico Subterráneo',
    title: 'Tendido Eléctrico Subterráneo'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/VACIADO DE CONCRETO EN LOSAS.jpg',
    alt: 'Vaciado de Concreto en Losas',
    title: 'Vaciado de Concreto en Losas'
  },
  {
    src: '/INFRAESTRUCTURA/INFRAESTRUCTURA/OBRAS CIVILES/VACIADO DE CONCRETO.jpg',
    alt: 'Vaciado de Concreto',
    title: 'Vaciado de Concreto'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">OBRAS CIVILES</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>