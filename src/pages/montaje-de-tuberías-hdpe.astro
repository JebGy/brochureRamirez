---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Montaje de tuberías HDPE
const images = [
  {
    src: '/MANTENIMIENTO/HDPE/06080021-54f7-42d5-9dbe-e063b0103253.png',
    alt: 'Tubería HDPE - Proyecto 1',
    title: 'Tubería HDPE - Proyecto 1'
  },
  {
    src: '/MANTENIMIENTO/HDPE/0c19d27a-e80c-4e75-82f5-48057fa70cad.jpg',
    alt: 'Tubería HDPE - Proyecto 2',
    title: 'Tubería HDPE - Proyecto 2'
  },
  {
    src: '/MANTENIMIENTO/HDPE/MODERNIZACIÓN DE TERMINAL PORTUARIO.jpg',
    alt: 'Modernización de Terminal Portuario',
    title: 'Modernización de Terminal Portuario'
  },
  {
    src: '/MANTENIMIENTO/HDPE/TUBERÍAS HDPE.png',
    alt: 'Tuberías HDPE',
    title: 'Tuberías HDPE'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">MONTAJE DE TUBERÍAS HDPE</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>