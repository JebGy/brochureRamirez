---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Camiones Grúa
const images = [
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMIONES GRUA/1dce16d6-5298-47c8-a638-ac9eadb19ae9.jpg',
    alt: 'Camión Grúa - Proyecto 1',
    title: 'Camión Grúa - Proyecto 1'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMIONES GRUA/558634f9-1480-425a-98ed-707ee5d5ddcd.jpg',
    alt: 'Camión Grúa - Proyecto 2',
    title: 'Camión Grúa - Proyecto 2'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMIONES GRUA/60fc7583-ba7d-42f8-b61f-28d6640bc9dd.jpg',
    alt: 'Camión Grúa - Proyecto 3',
    title: 'Camión Grúa - Proyecto 3'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMIONES GRUA/89530338-e6e3-4fa9-a9ac-1af50b857c67 (1).jpg',
    alt: 'Camión Grúa - Proyecto 4',
    title: 'Camión Grúa - Proyecto 4'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMIONES GRUA/CAMIÓN GRÚA 12TN.jpg',
    alt: 'Camión Grúa 12TN',
    title: 'Camión Grúa 12TN'
  }
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">CAMIONES GRÚA</h1>
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>