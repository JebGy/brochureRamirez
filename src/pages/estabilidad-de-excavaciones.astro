---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Estabilidad de Excavaciones
const images = [
  {
    src: '/GEOTECNIA/ESTABILIDAD DE EXCAVACIONES/OBRAS VIALES EN REFINERÍA.jpg',
    alt: 'Obras Viales en Refinería',
    title: 'Obras Viales en Refinería'
  },
  {
    src: '/GEOTECNIA/ESTABILIDAD DE EXCAVACIONES/REFORZAMIENTO DE EXCAVACIONES SUPERFICIALES.jpg',
    alt: 'Reforzamiento de Excavaciones Superficiales',
    title: 'Reforzamiento de Excavaciones Superficiales'
  }
];
---

<Layout>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-red-600 to-rose-700 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-altone-bold mb-4">Estabilidad de Excavaciones</h1>
      <p class="text-xl opacity-90 max-w-3xl mx-auto">
        Servicios especializados en reforzamiento y estabilización de excavaciones para garantizar la seguridad en obras de construcción.
      </p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center text-white hover:text-red-200 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }
  
  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>