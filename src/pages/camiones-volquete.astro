---
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

// Imágenes de Camiones Volquete
const images = [
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMION VOLQUETE/6b808f34-fd32-4abb-8b6e-b05ac6f84625.jpg',
    alt: 'Camión Volquete - Proyecto 1',
    title: 'Camión Volquete - Proyecto 1'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMION VOLQUETE/CAMIÓN VOLQUETE 17.5 M3(1).jpg',
    alt: 'Camión Volquete 17.5 M3',
    title: 'Camión Volquete 17.5 M3'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMION VOLQUETE/CAMIÓN VOLQUETE 17.5 M3(2).jpg',
    alt: 'Camión Volquete 17.5 M3',
    title: 'Camión Volquete 17.5 M3'
  },
  {
    src: '/ALQUILER DE EQUIPOS/ALQUILER DE EQUIPOS/CAMION VOLQUETE/CAMIÓN VOLQUETE 17.5 M3.jpg',
    alt: 'Camión Volquete 17.5 M3',
    title: 'Camión Volquete 17.5 M3'
  }
];
---

<Layout>
  <!-- Header Section -->
  <section class="bg-gradient-to-r from-amber-600 to-yellow-600 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-5xl font-altone-bold mb-4">Camiones Volquete</h1>
      <p class="text-xl opacity-90 max-w-3xl mx-auto">
        Alquiler de camiones volquete de gran capacidad para transporte de materiales en proyectos de construcción y minería.
      </p>
      <div class="mt-8">
        <a href="/" class="inline-flex items-center text-white hover:text-amber-200 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          Volver al inicio
        </a>
      </div>
    </div>
  </section>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }
  
  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>