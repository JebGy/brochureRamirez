---
import Layout from "../layouts/Layout.astro";
import GalleryGrid from "../components/GalleryGrid.astro";

// Imágenes de Movimientos de Tierra
const images = [
  {
    src: "/INFRAESTRUCTURA/INFRAESTRUCTURA/MOVIMIENTOS DE TIERRA/0fd6d0bd-90a5-4d02-903e-5aca3c05359f.webp",
    alt: "Movimiento de Tierra - Proyecto 1",
    title: "Movimiento de Tierra - Proyecto 1",
  },
  {
    src: "/INFRAESTRUCTURA/INFRAESTRUCTURA/MOVIMIENTOS DE TIERRA/OBRAS VIALES EN REFINERÍA.webp",
    alt: "Obras Viales en Refinería",
    title: "Obras Viales en Refinería",
  },
  {
    src: "/INFRAESTRUCTURA/INFRAESTRUCTURA/MOVIMIENTOS DE TIERRA/PLAN DE CIERRE EN REFINERÍA.png",
    alt: "Plan de Cierre en Refinería",
    title: "Plan de Cierre en Refinería",
  },
  {
    src: "/INFRAESTRUCTURA/INFRAESTRUCTURA/MOVIMIENTOS DE TIERRA/PLAN DE CIERRE.webp",
    alt: "Plan de Cierre",
    title: "Plan de Cierre",
  },
  {
    src: "/INFRAESTRUCTURA/INFRAESTRUCTURA/MOVIMIENTOS DE TIERRA/PLAN DE CIERRE.png",
    alt: "Plan de Cierre",
    title: "Plan de Cierre",
  },
];
---

<Layout>
  <!-- Header Section - Estilo Sunzine -->
  <header class="sunzine-header">
   

    <!-- Título principal -->
    <div class="hero-section">
      <h1 class="hero-title">MOVIMIENTOS DE TIERRA</h1>
   
    </div>
  </header>

  <!-- Gallery Section -->
  <GalleryGrid images={images} />
</Layout>

<style>
  /* Estilos Sunzine */
  .sunzine-header {
    background: linear-gradient(0deg, #FFF 0%, #e9ecef 100%);
    min-height: 20vh;
    display: flex;
    flex-direction: column;
  }

  .sunzine-nav {
    padding: 1rem 0;
    border-bottom: 1px solid #e9ecef;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo-text {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 1.5rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0;
  }

  .nav-menu {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    text-decoration: none;
    color: #6c757d;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #28a745;
  }

  .nav-icons {
    display: flex;
    gap: 1rem;
  }

  .search-btn,
  .menu-btn {
    background: none;
    border: none;
    color: #6c757d;
    cursor: pointer;
    padding: 0.5rem;
    transition: color 0.3s ease;
  }

  .search-btn:hover,
  .menu-btn:hover {
    color: #28a745;
  }

  .hero-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 3rem;
    font-weight: bold;
    color: #2c3e50;
    margin: 0 0 1rem 0;
    line-height: 1.2;
    max-width: 800px;
  }

  .hero-subtitle {
    font-family: 'Altone Trial-Regular', sans-serif;
    font-size: 1.5rem;
    color: #2c3e50;
    margin: 0 0 3rem 0;
    font-weight: normal;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #28a745;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .breadcrumb-icon {
    font-size: 1rem;
  }

  .breadcrumb-separator {
    color: #6c757d;
  }

  .breadcrumb-item {
    letter-spacing: 0.5px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav-menu {
      display: none;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.2rem;
    }

    .breadcrumb {
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>

<style>
  /* Estilos adicionales para el diseño tipo Pinterest */
  :global(.gallery-item) {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    :global(.grid) {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    :global(.grid) {
      column-count: 3;
      column-gap: 2rem;
    }
  }

  @media (min-width: 1280px) {
    :global(.grid) {
      column-count: 4;
      column-gap: 2rem;
    }
  }
</style>
