---
const { image, index, class: className = '' } = Astro.props;
---

<div 
  class={`sunzine-gallery-item group cursor-pointer ${className}`}
  data-src={image.src}
  data-alt={image.alt}
  data-title={image.title}
  onclick={`openModal(${index})`}
>
  <div class="sunzine-image-container">
    <img 
      src={image.src} 
      alt={image.alt}
      class="sunzine-image"
      loading="lazy"
    />
    
    <!-- Overlay sutil estilo Sunzine -->
    <div class="sunzine-overlay">
      <div class="sunzine-overlay-content">
        <h3 class="sunzine-title">{image.title}</h3>
        <p class="sunzine-subtitle">Ver imagen completa</p>
      </div>
    </div>
  </div>
</div>

<style>
  .sunzine-gallery-item {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .sunzine-gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .sunzine-image-container {
    position: relative;
    overflow: hidden;
  }

  .sunzine-image {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .sunzine-gallery-item:hover .sunzine-image {
    transform: scale(1.05);
  }

  .sunzine-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
  }

  .sunzine-gallery-item:hover .sunzine-overlay {
    opacity: 1;
  }

  .sunzine-overlay-content {
    color: white;
  }

  .sunzine-title {
    font-family: 'Altone Trial-Bold', sans-serif;
    font-size: 1.1rem;
    font-weight: bold;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .sunzine-subtitle {
    font-size: 0.9rem;
    opacity: 0.9;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .sunzine-overlay {
      padding: 1rem;
    }

    .sunzine-title {
      font-size: 1rem;
    }

    .sunzine-subtitle {
      font-size: 0.8rem;
    }
  }
</style>